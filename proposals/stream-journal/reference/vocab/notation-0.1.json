{
  "notation": "glyph@0.1",
  "note": "Glyphs, positional payloads and quantity codes for the run form (STREAM-NOTATION draft). A glyph is scoped by its OP letter: B( and R( are different record types that share the generic meaning 'open'.",
  "glyph_meanings": {
    "(": "open an interval",
    ")": "close an interval",
    "+": "create / add",
    "*": "modify",
    ".": "complete / finish",
    "-": "remove / delete",
    "=": "observed value",
    "~": "estimated value",
    ">": "post a transfer",
    "<": "reverse a transfer",
    "/": "amend (supersede)",
    ":": "annotate",
    "!": "alert / failure",
    "?": "query",
    "[": "journal segment open",
    "]": "journal segment seal",
    "x": "journal rejection"
  },
  "glyphs": {
    "T.add": "+",
    "T.modify": "*",
    "T.start": "(",
    "T.done": ".",
    "T.delete": "-",
    "B.start": "(",
    "B.stop": ")",
    "R.open": "(",
    "R.close": ")",
    "M.measure": "=",
    "M.estimate": "~",
    "L.post": ">",
    "L.amend": "/",
    "L.reverse": "<",
    "A.note": ":",
    "D.sample": "=",
    "S.open": "[",
    "S.seal": "]",
    "S.reject": "x"
  },
  "positional": {
    "T.add": [["desc", "text"]],
    "M.measure": [["q", "qty"]],
    "M.estimate": [["q", "qty"], ["method", "str"]],
    "R.open": [["run", "str"], ["span", "str"], ["parent", "str"]],
    "R.close": [["run", "str"], ["status", "str"], ["use", "qtymap"]],
    "L.post": [["legs", "legs"]],
    "L.amend": [["ref", "str"], ["reason", "text"], ["legs", "legs"]],
    "L.reverse": [["ref", "str"], ["reason", "text"]],
    "A.note": [["text", "text"]],
    "S.open": [["vocab", "str"], ["prev", "str"]],
    "S.seal": [["n", "int"], ["sha256", "str"], ["chain", "str"]],
    "S.reject": [["digest", "str"], ["reason", "text"]]
  },
  "quantities": {
    "xs": {"kind": "cpu time", "unit": "s", "conserved": true},
    "J": {"kind": "energy", "unit": "J", "conserved": true},
    "B": {"kind": "bytes moved (io)", "unit": "byte", "conserved": true},
    "wB": {"kind": "bytes moved (wire)", "unit": "byte", "conserved": true},
    "ti": {"kind": "input tokens", "unit": "token", "conserved": true},
    "to": {"kind": "output tokens", "unit": "token", "conserved": true},
    "tr": {"kind": "cache-read tokens", "unit": "token", "conserved": true},
    "tw": {"kind": "cache-write tokens", "unit": "token", "conserved": true},
    "#": {"kind": "sub-acts not recorded individually", "unit": "count", "conserved": true},
    "kg": {"kind": "mass", "unit": "kg", "conserved": true},
    "USD": {"kind": "money (ISO 4217)", "unit": "USD", "conserved": true}
  }
}
